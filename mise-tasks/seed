#!/usr/bin/env bash
#MISE description="Create a few example functions on a running server (Lua + Starlark; covers create/env/kv)"
#MISE depends=["build-cli"]
set -euo pipefail

SERVER="${LUNAR_SERVER:-http://localhost:${PORT:-3000}}"
TOKEN="${LUNAR_TOKEN:-${API_KEY:-}}"
if [ -z "$TOKEN" ] && [ -f "${DATA_DIR:-./data}/api_key.txt" ]; then
  TOKEN="$(cat "${DATA_DIR:-./data}/api_key.txt")"
fi
if [ -z "$TOKEN" ]; then
  echo "No API token found. Set LUNAR_TOKEN or API_KEY, or start the server once" >&2
  echo "so that ${DATA_DIR:-./data}/api_key.txt is generated, then re-run." >&2
  exit 1
fi
export LUNAR_SERVER="$SERVER" LUNAR_TOKEN="$TOKEN"
CLI="$BUILD_DIR/$CLI_BINARY_NAME"

# create_fn <name> <description> [language] ; reads code from stdin ; prints the
# new id. Language defaults to lua.
create_fn() {
  "$CLI" functions create --name "$1" --description "$2" --language "${3:-lua}" --code - -o json \
    | sed -n 's/^  "id": "\([^"]*\)".*/\1/p' | head -1
}

echo "Seeding $SERVER ..."

# ─── Lua examples ──────────────────────────────────────────────

# 1. hello — the simplest possible function.
create_fn hello "Returns a plain-text greeting" >/dev/null <<'LUA'
function handler(ctx, event)
  return { statusCode = 200, body = "Hello from Lunar!\n" }
end
LUA

# 2. echo — reflects the incoming request back as JSON.
create_fn echo "Echoes the request as JSON" >/dev/null <<'LUA'
function handler(ctx, event)
  local body, err = json.encode({
    method = event.method,
    path = event.relativePath,
    query = event.query,
    body = event.body,
  })
  if err then return { statusCode = 500, body = err } end
  return {
    statusCode = 200,
    headers = { ["Content-Type"] = "application/json" },
    body = body,
  }
end
LUA

# 3. counter — persists a hit count in the KV store; seed an initial value.
COUNTER_ID="$(create_fn counter "Counts requests via the KV store" <<'LUA'
function handler(ctx, event)
  local n = tonumber(kv.get("count") or "0") + 1
  kv.set("count", tostring(n))
  return { statusCode = 200, body = "count: " .. n .. "\n" }
end
LUA
)"
"$CLI" functions kv "$COUNTER_ID" --global=false --kv count=100 >/dev/null

# 4. greet — reads a greeting from an env var; seed the env var.
GREET_ID="$(create_fn greet "Greets using an env var" <<'LUA'
function handler(ctx, event)
  local greeting = env.get("GREETING") or "Hello"
  local who = event.query["name"] or "world"
  return { statusCode = 200, body = greeting .. ", " .. who .. "!\n" }
end
LUA
)"
"$CLI" functions env "$GREET_ID" --env GREETING=Howdy >/dev/null

# ─── Starlark examples ─────────────────────────────────────────

# 5. hello-starlark — the simplest possible Starlark function.
create_fn hello-starlark "Returns a plain-text greeting (Starlark)" starlark >/dev/null <<'STARLARK'
def handler(ctx, event):
    return {"statusCode": 200, "body": "Hello from Lunar (Starlark)!\n"}
STARLARK

# 6. echo-starlark — reflects the incoming request back as JSON.
create_fn echo-starlark "Echoes the request as JSON (Starlark)" starlark >/dev/null <<'STARLARK'
def handler(ctx, event):
    body, err = json.encode({
        "method": event.method,
        "path": event.relativePath,
        "query": event.query,
        "body": event.body,
    })
    if err != None:
        return {"statusCode": 500, "body": err}
    return {
        "statusCode": 200,
        "headers": {"Content-Type": "application/json"},
        "body": body,
    }
STARLARK

# 7. counter-starlark — persists a hit count in the KV store; seed a value.
COUNTER_STAR_ID="$(create_fn counter-starlark "Counts requests via the KV store (Starlark)" starlark <<'STARLARK'
def handler(ctx, event):
    n = int(kv.get("count") or "0") + 1
    kv.set("count", str(n))
    return {"statusCode": 200, "body": "count: " + str(n) + "\n"}
STARLARK
)"
"$CLI" functions kv "$COUNTER_STAR_ID" --global=false --kv count=100 >/dev/null

# 8. greet-starlark — reads a greeting from an env var; seed the env var.
GREET_STAR_ID="$(create_fn greet-starlark "Greets using an env var (Starlark)" starlark <<'STARLARK'
def handler(ctx, event):
    greeting = env.get("GREETING") or "Hello"
    who = event.query.get("name", "world")
    return {"statusCode": 200, "body": greeting + ", " + who + "!\n"}
STARLARK
)"
"$CLI" functions env "$GREET_STAR_ID" --env GREETING=Howdy >/dev/null

echo "Done. Created Lua: hello, echo, counter, greet"
echo "      Created Starlark: hello-starlark, echo-starlark, counter-starlark, greet-starlark"
echo "Try:  curl $SERVER/fn/$GREET_ID?name=Lunar"
echo "      curl $SERVER/fn/$GREET_STAR_ID?name=Lunar"
